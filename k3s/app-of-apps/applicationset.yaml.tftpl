apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: app-of-apps
  namespace: argocd
spec:
  generators:
    - list:
        elements:
          - name: cert-manager
            namespace: app-of-apps
            repoURL: https://charts.jetstack.io
            chart: cert-manager
            targetRevision: v1.21.2
            syncWave: "0"
            valuesYaml: |
              installCRDs: true
              image:
                repository: quay.io/jetstack/cert-manager-controller
                tag: v1.21.2
              webhook:
                image:
                  repository: quay.io/jetstack/cert-manager-webhook
                  tag: v1.21.2
                hostNetwork: false
              cainjector:
                image:
                  repository: quay.io/jetstack/cert-manager-cainjector
                  tag: v1.21.2
              securityContext:
                runAsNonRoot: true
                runAsUser: 1000
                runAsGroup: 1000
                fsGroup: 1000
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 100m
                  memory: 128Mi
              extraArgs:
                - --enable-certificate-owner-ref=true
                - --max-concurrent-challenges=1
                - --dns01-recursive-nameservers=8.8.8.8:53,1.1.1.1:53
                - --dns01-recursive-nameservers-only
              prometheus:
                enabled: true
                servicemonitor:
                  enabled: false

          - name: eso
            namespace: app-of-apps
            repoURL: https://charts.external-secrets.io
            chart: external-secrets
            targetRevision: 0.20.2
            syncWave: "1"
            valuesYaml: |
              installCRDs: true
              deploymentAnnotations:
                reloader.stakater.com/search: "true"
              # No webhook.tls/certManager block: verified via `helm show values` against the
              # real v0.20.2 chart that no such field exists - the webhook manages its own TLS
              # cert internally (eso-external-secrets-cert-controller), already working with
              # chart defaults. Legacy's values.yaml assumed an older chart schema.
              bitwarden-sdk-server:
                enabled: true
                podAnnotations:
                  secret.reloader.stakater.com/reload: "bitwarden-tls-certs"
                # image.tls.enabled defaults to true already (see values schema) - the subchart
                # expects a pre-existing bitwarden-tls-certs Secret, it does not create one via
                # any certManager values field (also verified - no such field exists here
                # either). See bitwarden-sdk-server-tls.yaml, applied directly by Tofu.
                resources:
                  requests:
                    cpu: 50m
                    memory: 128Mi
                  limits:
                    memory: 512Mi

          - name: reloader
            namespace: app-of-apps
            repoURL: https://stakater.github.io/stakater-charts
            chart: reloader
            targetRevision: 2.2.17
            syncWave: "3"
            valuesYaml: |
              reloader:
                watchGlobally: true

          - name: external-dns-do
            namespace: app-of-apps
            # NOT an OCI registry - registry.k8s.io/external-dns/charts/external-dns has zero
            # published tags (verified live: empty tags list via the registry's own API), a
            # research error that sat unnoticed since the first apply. The real, current,
            # official source is a classic Helm HTTP repo (confirmed via the chart's own README).
            repoURL: https://kubernetes-sigs.github.io/external-dns/
            chart: external-dns
            targetRevision: 1.22.0
            syncWave: "4"
            valuesYaml: |
              provider:
                name: digitalocean
              env:
                - name: DO_TOKEN
                  valueFrom:
                    secretKeyRef:
                      name: do-dns-api-key
                      key: api-key
              domainFilters:
                - amer.dev
              sources:
                - ingress
                - service
                - crd
              policy: sync
              interval: 5m
              minEventSyncInterval: 5m
              txtOwnerId: "external-dns-do"
              txtPrefix: "do-"
              logLevel: info
              logFormat: text

          - name: openebs
            namespace: openebs
            repoURL: https://openebs.github.io/lvm-localpv
            chart: lvm-localpv
            targetRevision: 1.10.1
            syncWave: "5"
            valuesYaml: |
              lvmPlugin:
                image:
                  pullPolicy: IfNotPresent
              analytics:
                enabled: false

  template:
    metadata:
      name: "{{name}}"
      annotations:
        argocd.argoproj.io/sync-wave: "{{syncWave}}"
        # Forces ArgoCD to re-evaluate immediately on every `tofu apply`, bypassing its own
        # retry backoff for a previously-failing sync (hit this live: ESO's sync had failed
        # repeatedly before a fix landed, and ArgoCD's backoff meant it needed a manual
        # `argocd app sync` rather than picking the fix up right away). refresh_token is
        # Tofu's timestamp() at apply time - a fresh value every apply, so the annotation is
        # always "new" from ArgoCD's perspective even though it clears the annotation itself
        # after processing.
        argocd.argoproj.io/refresh: "${refresh_token}"
    spec:
      project: default
      source:
        repoURL: "{{repoURL}}"
        chart: "{{chart}}"
        targetRevision: "{{targetRevision}}"
        helm:
          values: "{{valuesYaml}}"
      destination:
        server: https://kubernetes.default.svc
        namespace: "{{namespace}}"
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
          # ESO's ClusterSecretStore/SecretStore CRDs are large enough (many provider schemas)
          # that the client-side apply's kubectl.kubernetes.io/last-applied-configuration
          # annotation exceeds Kubernetes' 262144-byte annotation limit. Server-side apply
          # doesn't use that annotation at all, avoiding the size limit. Applied cluster-wide
          # here (safe for every component, not just ESO).
          - ServerSideApply=true
